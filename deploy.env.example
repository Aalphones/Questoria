# Kopiere diese Datei nach "deploy.env" und trage deine Werte ein.
# deploy.env landet NICHT im Git — sie enthaelt Klartext-Zugangsdaten.
#
# Sonderzeichen im Passwort sind in Ordnung: das Skript reicht Benutzer und Passwort
# als eigene Angaben an WinSCP weiter, nicht als Teil einer Adresse. Einzige Ausnahme
# ist ein doppeltes Anfuehrungszeichen (") im Passwort — das geht nicht.

# ── Hochladen ────────────────────────────────────────────────────────────────
# Pfad zur WinSCP-Konsole. Nicht WinSCP.exe (das ist die Oberflaeche), sondern
# WinSCP.com. Bei der Installation ueber winget liegt sie hier:
WINSCP_PATH=C:\Users\sasch\AppData\Local\Programs\WinSCP\WinSCP.com

# sftp oder ftp. Bietet dein Strato-Paket kein SFTP: hier ftp eintragen, dann wird
# SFTP_HOSTKEY nicht gebraucht und darf leer bleiben.
SFTP_PROTOCOL=sftp
SFTP_HOST=
SFTP_USER=
SFTP_PASSWORD=

# Nur bei sftp noetig. Format ohne "SHA256:"-Praefix, genau so wie WinSCP es meldet:
#   ssh-ed25519 255 1gx2w8Rtv3wCgi7Jh8myf...
# So kommst du dran: WinSCP von Hand verbinden, dann Strg+I ("Server- und
# Protokollinformationen") und den Fingerabdruck kopieren. Alternativ einmal mit
# irgendeinem Wert hier starten — WinSCP bricht ab und nennt den echten Abdruck.
# Kein Stern als Platzhalter — der wuerde jeden Server akzeptieren, der sich fuer
# deinen ausgibt.
SFTP_HOSTKEY=

# Zielverzeichnisse auf dem Server, wie sie nach dem Anmelden sichtbar sind.
# REMOTE_API_PATH bekommt den Inhalt von backend/, REMOTE_APP_PATH den gebauten
# Frontend-Ordner. Die Web-Wurzel der API sollte auf deren Unterordner public/
# zeigen; geht das bei deinem Paket nicht, greift backend/.htaccess als Notnagel.
REMOTE_API_PATH=/api/
REMOTE_APP_PATH=/

# Ausgabeordner des Frontend-Builds.
FRONTEND_DIST=frontend\dist\frontend\browser

# ── Wird nach backend/.env geschrieben ───────────────────────────────────────
APP_ENV=production

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Lange Zufallsfolge, signiert die Anmelde-Token. Nicht der Beispielwert aus
# backend/.env.example — der steht im Git und ist damit kein Geheimnis mehr.
JWT_SECRET=

# Kommagetrennt. Muss die Adresse enthalten, unter der das Frontend laeuft —
# und beim lokalen Entwickeln zusaetzlich http://localhost:4200.
CORS_ORIGINS=http://localhost:4200
