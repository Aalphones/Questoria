# Kopie dieser Datei nach ".env" — die landet nicht im Git.
# Im echten Betrieb schreibt "deploy.cmd" die Datei aus "deploy.env";
# von Hand angelegt wird sie nur fuer einen lokalen Start.

APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=questoria
DB_USER=questoria
DB_PASS=

# Lange Zufallsfolge. Signiert die Anmelde-Token ab Meilenstein 4.
JWT_SECRET=change-me-in-production

# Kommagetrennte Liste erlaubter Herkuenfte. Das lokal entwickelte Frontend
# spricht gegen die API auf dem Server — ohne diesen Eintrag blockt der Browser.
CORS_ORIGINS=http://localhost:4200
