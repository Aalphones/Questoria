# Kopie dieser Datei nach ".env" — die landet nicht im Git.
# Im echten Betrieb schreibt "deploy.cmd" die Datei aus "deploy.env";
# von Hand angelegt wird sie nur fuer einen lokalen Start.

APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=questoria
DB_USER=questoria
DB_PASS=

# Lange Zufallsfolge. Signiert die Anmelde-Token ab Meilenstein 4.
JWT_SECRET=change-me-in-production

# Lange Zufallsfolge. Schuetzt die Serverauskunft unter /api/diag.php; ohne den
# passenden Wert im Kopf "X-Diag-Token" antwortet sie mit 404.
DIAG_TOKEN=

# Lange Zufallsfolge, eigenstaendig. Schuetzt den Migrations-Endpoint unter
# POST /api/migrate; ohne den passenden Wert im Kopf "X-Migrate-Token"
# antwortet er mit 404.
MIGRATE_TOKEN=

# true: bei jedem echten API-Aufruf automatisch fehlende Migrationen anwenden.
# false: Not-Aus, dann nur noch ueber POST /api/migrate von Hand. Leer wird wie
# "true" behandelt.
AUTO_MIGRATE=true

# Oeffentliche Adresse der Anwendung, ohne Schraegstrich am Ende.
PUBLIC_BASE_URL=http://localhost:4200

# Kommagetrennte Liste erlaubter Herkuenfte. Das lokal entwickelte Frontend
# spricht gegen die API auf dem Server — ohne diesen Eintrag blockt der Browser.
CORS_ORIGINS=http://localhost:4200
