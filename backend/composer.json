{
    "name": "questoria/backend",
    "description": "Questoria PHP REST API",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "firebase/php-jwt": "^7.0",
        "monolog/monolog": "^3.7",
        "nikic/fast-route": "^1.3",
        "respect/validation": "^2.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "lint:fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.9"
        }
    }
}
